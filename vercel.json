{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "diamantesrealtygroup.com"
        }
      ],
      "destination": "https://www.diamantesrealtygroup.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/agent-dashboard",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/agent-dashboard.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/property-sheet",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/property-sheet.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/js/property-sheet.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/js/property-sheet-reliability.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/js/home-vip-refresh.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/js/home-curtain-reveal.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/js/agent-dashboard.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/css/home-vip-refresh.css",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/css/agent-dashboard-emergency-fix.css",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/propiedades", "destination": "/propiedades.html" },
    { "source": "/propiedad", "destination": "/propiedad.html" },
    { "source": "/agentes", "destination": "/agentes.html" },
    { "source": "/agente", "destination": "/agente.html" },
    { "source": "/agent", "destination": "/agent.html" },
    { "source": "/mapa", "destination": "/mapa.html" },
    { "source": "/contacto", "destination": "/contacto.html" },
    { "source": "/nosotros", "destination": "/nosotros.html" },
    { "source": "/educacion", "destination": "/educacion.html" },
    { "source": "/quieres-vender", "destination": "/quieres-vender.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin-login", "destination": "/admin-login.html" },
    { "source": "/agent-dashboard", "destination": "/agent-dashboard.html" },
    { "source": "/property-sheet/:propertyId", "destination": "/property-sheet.html" },
    { "source": "/share", "destination": "/share.html" },
    { "source": "/share-property", "destination": "/share-property.html" },
    { "source": "/share/property/:propertyId", "destination": "/api/property-share?id=:propertyId" },
    { "source": "/access-denied", "destination": "/access-denied.html" },
    { "source": "/politicas-de-privacidad", "destination": "/politicas-de-privacidad.html" },
    { "source": "/condiciones-de-uso", "destination": "/condiciones-de-uso.html" },
    { "source": "/licencia-de-operacion", "destination": "/licencia-de-operacion.html" }
  ]
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.admin == true
          || (exists(/databases/$(database)/documents/agents/$(request.auth.uid))
            && get(/databases/$(database)/documents/agents/$(request.auth.uid)).data.role == 'admin'));
    }

    function requestEmail() {
      return isSignedIn() && request.auth.token.email != null ? request.auth.token.email : '';
    }

    function isOwnAgentProfile(data, profileId) {
      return isSignedIn() && (
        profileId == request.auth.uid
        || data.uid == request.auth.uid
        || data.userId == request.auth.uid
        || data.agentId == request.auth.uid
        || (requestEmail() != '' && (data.email == requestEmail() || data.correo == requestEmail()))
      );
    }

    function isOwnProperty(data) {
      return isSignedIn() && (
        data.agentId == request.auth.uid
        || data.agenteId == request.auth.uid
        || data.createdBy == request.auth.uid
        || data.ownerId == request.auth.uid
        || data.userId == request.auth.uid
        || (requestEmail() != '' && (
          data.agentEmail == requestEmail()
          || data.email == requestEmail()
          || data.createdByEmail == requestEmail()
          || data.ownerEmail == requestEmail()
          || data.createdBy == requestEmail()
        ))
      );
    }

    function isPublicProperty(data) {
      return (data.publicationStatus == 'approved' && data.publicVisible == true)
        || (!data.keys().hasAny(['publicationStatus']) && !data.keys().hasAny(['publicVisible']));
    }

    function isOwnSharedList(data) {
      return isSignedIn() && (
        data.createdByAgentId == request.auth.uid
        || data.agentId == request.auth.uid
        || data.createdBy == request.auth.uid
        || (requestEmail() != '' && (
          data.createdByAgentEmail == requestEmail()
          || data.agentEmail == requestEmail()
          || data.createdByEmail == requestEmail()
          || data.email == requestEmail()
        ))
      );
    }

    function isValidCommercialStatus(data) {
      return !data.keys().hasAny(['status'])
        || data.status in ['Disponible', 'Reservada', 'Vendida', 'Rentada', 'available', 'reserved', 'sold', 'rented'];
    }

    function agentCreateIsReviewOnly() {
      return isSignedIn()
        && request.resource.data.agentId == request.auth.uid
        && request.resource.data.publicationStatus == 'pending_review'
        && request.resource.data.publicVisible == false
        && isValidCommercialStatus(request.resource.data);
    }

    function agentUpdateIsAllowed() {
      return isOwnProperty(resource.data)
        && isOwnProperty(request.resource.data)
        && isValidCommercialStatus(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy', 'reviewedAt'
        ])
        && (
          (resource.data.publicationStatus == 'approved'
            && resource.data.publicVisible == true
            && request.resource.data.publicationStatus == 'approved'
            && request.resource.data.publicVisible == true)
          || (resource.data.publicationStatus == 'rejected'
            && request.resource.data.publicationStatus == 'pending_review'
            && request.resource.data.publicVisible == false)
          || (resource.data.publicationStatus in ['pending_review', 'draft', 'archived']
            && request.resource.data.publicationStatus == resource.data.publicationStatus
            && request.resource.data.publicVisible == false)
          || (!resource.data.keys().hasAny(['publicationStatus'])
            && !resource.data.keys().hasAny(['publicVisible'])
            && request.resource.data.publicationStatus == 'approved'
            && request.resource.data.publicVisible == true)
        );
    }

    match /agents/{agentId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.auth.uid == agentId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == agentId || isOwnAgentProfile(resource.data, agentId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /agentes/{agentId} {
      allow get: if (isSignedIn() && request.auth.uid == agentId) || isOwnAgentProfile(resource.data, agentId) || isAdmin();
      allow list: if isOwnAgentProfile(resource.data, agentId) || isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == agentId || isAdmin());
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if (isSignedIn() && request.auth.uid == userId) || isOwnAgentProfile(resource.data, userId) || isAdmin();
      allow list: if isOwnAgentProfile(resource.data, userId) || isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /usuarios/{userId} {
      allow get: if (isSignedIn() && request.auth.uid == userId) || isOwnAgentProfile(resource.data, userId) || isAdmin();
      allow list: if isOwnAgentProfile(resource.data, userId) || isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /agentProfiles/{profileId} {
      allow get: if (isSignedIn() && request.auth.uid == profileId) || isOwnAgentProfile(resource.data, profileId) || isAdmin();
      allow list: if isOwnAgentProfile(resource.data, profileId) || isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == profileId || isAdmin());
      allow delete: if isAdmin();
    }

    match /properties/{propertyId} {
      allow get: if isPublicProperty(resource.data)
        || isOwnProperty(resource.data)
        || isAdmin();
      allow list: if true;
      allow create: if isSignedIn() && (isAdmin() || agentCreateIsReviewOnly());
      allow update: if isSignedIn() && (isAdmin() || agentUpdateIsAllowed());
      allow delete: if isSignedIn() && (isOwnProperty(resource.data) || isAdmin());
    }

    match /properties/{propertyId}/comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.propertyId == propertyId
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /properties/{propertyId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.propertyId == propertyId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /properties/{propertyId}/favorites/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.propertyId == propertyId
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /sharedPropertyLists/{listId} {
      allow read: if resource.data.status == 'active'
        || isOwnSharedList(resource.data)
        || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.createdByAgentId == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 12
        && request.resource.data.propertyIds is list
        && request.resource.data.status in ['active', 'inactive'];

      allow update: if isSignedIn() && (
          (isOwnSharedList(resource.data)
            && isOwnSharedList(request.resource.data)
            && request.resource.data.token == resource.data.token)
          || isAdmin()
        );

      allow delete: if isSignedIn() && (isOwnSharedList(resource.data) || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

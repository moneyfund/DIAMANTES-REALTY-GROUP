rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedEmail() { return signedIn() && request.auth.token.email_verified == true; }
    function email() { return signedIn() ? request.auth.token.email : ""; }
    function accessExists() { return signedIn() && exists(/databases/$(database)/documents/access/$(request.auth.uid)); }
    function accessRole() { return accessExists() ? get(/databases/$(database)/documents/access/$(request.auth.uid)).data.get("role","") : ""; }
    function isAdmin() { return verifiedEmail() && (email() in ["norvingarcia220@gmail.com", "diego.valdivia.52056@gmail.com", "diamantesrealtygroup@gmail.com"] || accessRole()=="admin"); }
    function isAgent() {
      return verifiedEmail() && (
        isAdmin() ||
        email() in ["norvingarcia220@gmail.com", "valop27@gmail.com", "dra.nazarethbravo@gmail.com", "diego.valdivia.52056@gmail.com", "27marvin@gmail.com", "rubenn2121@gmail.com", "dr.americamora@gmail.com", "norlanflores3@gmail.com", "amyblandon.as@gmail.com", "marccenarokarel@gmail.com", "caguadamuzmoreno@gmail.com", "agentenorvingarcia@gmail.com", "valenzuela.ing120@gmail.com", "nazarethbravo.realestate@gmail.com", "uh243384@gmail.com"] ||
        accessRole()=="agent" ||
        exists(/databases/$(database)/documents/agents/$(request.auth.uid))
      );
    }
    function f(data,key) { return data.get(key,""); }
    function ownProperty(data) {
      return signedIn() && (
        f(data,"agentId")==request.auth.uid ||
        f(data,"agenteId")==request.auth.uid ||
        f(data,"ownerId")==request.auth.uid ||
        f(data,"userId")==request.auth.uid ||
        f(data,"createdBy")==request.auth.uid ||
        f(data,"agentEmail")==email() ||
        f(data,"createdByEmail")==email() ||
        f(data,"ownerEmail")==email()
      );
    }
    function publicProperty(data) {
      return f(data,"visibility") in ["","public"] && (
        (f(data,"publicationStatus")=="approved" && data.get("publicVisible",false)==true) ||
        (!("publicationStatus" in data) && !("publicVisible" in data))
      );
    }
    function agentReadable(data) {
      return isAgent() && (f(data,"visibility") in ["","public","agents"] || ownProperty(data));
    }
    function assistedAuditValid(propertyId,data) {
      return isAgent() &&
        existsAfter(/databases/$(database)/documents/propertyListingAudit/$(propertyId)) &&
        getAfter(/databases/$(database)/documents/propertyListingAudit/$(propertyId)).data.get("uploadedByAgentId","")==request.auth.uid &&
        getAfter(/databases/$(database)/documents/propertyListingAudit/$(propertyId)).data.get("ownerAgentId","")==f(data,"agentId");
    }
    function samePublicationState(before,after) {
      return f(after,"publicationStatus")==f(before,"publicationStatus") &&
        after.get("publicVisible",false)==before.get("publicVisible",false);
    }
    function rejectedResubmission(before,after) {
      return f(before,"publicationStatus")=="rejected" &&
        f(after,"publicationStatus")=="pending_review" &&
        after.get("publicVisible",false)==false;
    }
    function legacyApprovalTransition(before,after) {
      return !("publicationStatus" in before) &&
        f(after,"publicationStatus")=="approved" &&
        after.get("publicVisible",false)==true;
    }

    match /properties/{propertyId} {
      allow read: if publicProperty(resource.data) || isAdmin() || agentReadable(resource.data);
      allow create: if isAdmin() || (
        isAgent() &&
        (ownProperty(request.resource.data) || assistedAuditValid(propertyId,request.resource.data)) &&
        f(request.resource.data,"publicationStatus") in ["draft","pending_review"] &&
        request.resource.data.get("publicVisible",false)==false
      );
      allow update: if isAdmin() || (
        isAgent() &&
        ownProperty(resource.data) &&
        ownProperty(request.resource.data) &&
        (
          samePublicationState(resource.data,request.resource.data) ||
          rejectedResubmission(resource.data,request.resource.data) ||
          legacyApprovalTransition(resource.data,request.resource.data)
        )
      );
      allow delete: if isAdmin() || (isAgent() && ownProperty(resource.data));

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.get("userId","")==request.auth.uid;
        allow update, delete: if isAdmin() || (signedIn() && resource.data.get("userId","")==request.auth.uid);
      }
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.get("userId","")==request.auth.uid;
        allow update, delete: if isAdmin() || (signedIn() && resource.data.get("userId","")==request.auth.uid);
      }
    }

    match /agents/{agentId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isAgent() &&
        request.resource.data.get("uid","")==request.auth.uid &&
        request.resource.data.get("email","")==email()
      );
      allow update: if isAdmin() || (
        isAgent() &&
        (resource.data.get("uid","")==request.auth.uid || resource.data.get("email","")==email()) &&
        (request.resource.data.get("uid","")==request.auth.uid || request.resource.data.get("email","")==email())
      );
      allow delete: if isAdmin();
    }

    match /formularios/{formId} {
      allow create: if
        request.resource.data.get("tipo","") in ["contacto","quiero-vender"] &&
        request.resource.data.get("estado","")=="nuevo" &&
        request.resource.data.get("origen","")=="web-publica" &&
        request.resource.data.get("nombre","").size() > 0 &&
        request.resource.data.get("nombre","").size() <= 100 &&
        request.resource.data.get("telefono","").size() > 0 &&
        request.resource.data.get("telefono","").size() <= 30 &&
        request.resource.data.get("correo","").size() > 0 &&
        request.resource.data.get("correo","").size() <= 160 &&
        request.resource.data.get("mensaje","").size() > 0 &&
        request.resource.data.get("mensaje","").size() <= 3000;
      allow read, update, delete: if isAdmin();
    }

    match /sharedPropertyLists/{listId} {
      allow create: if isAgent() && request.resource.data.get("createdByAgentId","")==request.auth.uid;
      allow read: if isAdmin() || (
        isAgent() && (
          resource.data.get("createdByAgentId","")==request.auth.uid ||
          resource.data.get("createdByAgentEmail","")==email() ||
          resource.data.get("agentEmail","")==email()
        )
      );
      allow update, delete: if isAdmin() || (
        isAgent() && (
          resource.data.get("createdByAgentId","")==request.auth.uid ||
          resource.data.get("createdByAgentEmail","")==email()
        )
      );
    }

    match /propertyListingAudit/{propertyId} {
      allow read: if isAdmin();
      allow create: if isAgent() &&
        request.resource.data.get("propertyId","")==propertyId &&
        request.resource.data.get("uploadedByAgentId","")==request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /access/{uid} {
      allow read: if signedIn() && (uid==request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
